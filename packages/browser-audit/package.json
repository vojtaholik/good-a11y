{
  "name": "@eaa-check/browser-audit",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "imports": {
    "#page-scripts": {
      "types": "./src/page-scripts.d.ts",
      "default": "./dist/page/scripts.js"
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p page/tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && tsc -p page/tsconfig.json && node scripts/embed-page-scripts.ts",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@eaa-check/core": "workspace:*",
    "axe-core": "4.14.0",
    "effect": "4.0.0",
    "puppeteer-core": "25.13.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
