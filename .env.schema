# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Scanner Worker, read at deploy: true turns on the empty form submits of the
# rendered check (docs/rendered-probes.md). Unset or false everywhere else.
# @type=boolean
# @sensitive=false
EMPTY_SUBMITS=

# Local check (apps/good-a11y check): the Chrome or Chromium binary it drives
# when --chrome is not given. Unset, it drives the installed Google Chrome. Our
# tests and evals set it to chrome-headless-shell (packages/browser-audit
# headless-shell.ts) so no Chrome window opens.
# @type=string
# @sensitive=false
GOOD_A11Y_CHROME=

# Set by vitest in every test process (not by us). When the local check runs
# under a test with neither --chrome nor GOOD_A11Y_CHROME, it exits instead of
# opening the installed Google Chrome.
# @type=string
# @sensitive=false
VITEST=

# Eval graders (evals/graders): the page a grader asserts against. Unset, each
# grader opens its guide's demo.html. The eval runner sets it to an agent's
# built page.
# @type=url
# @sensitive=false
EVAL_TARGET_URL=
