{
  "name": "@eaa-check/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "eaa-check": "./bin/eaa-check"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@eaa-check/capability": "workspace:*",
    "@eaa-check/core": "workspace:*",
    "@eaa-check/html-reader": "workspace:*",
    "@eaa-check/http-transport": "workspace:*",
    "@effect/platform-node": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
