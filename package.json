{
  "name": "good-a11y-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility guidance for coding agents, with the checker on top: guides, search, retrieve and a local check, on rat-stack.",
  "license": "MIT",
  "bin": {
    "good-a11y": "apps/good-a11y/bundle/good-a11y.mjs"
  },
  "files": [
    "apps/good-a11y/bundle",
    "skills/good-a11y"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck && ultracite check && oxfmt --check .",
    "cli": "turbo run build --filter=@good-a11y/cli && node apps/cli/dist/cli.js",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck-scripts": "tsc --noEmit -p tsconfig.json",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "facts": "pnpm --filter @good-a11y/facts run facts",
    "guides": "pnpm --filter @good-a11y/guides run guides",
    "evals:graders": "pnpm --filter @good-a11y/evals run graders",
    "good-a11y:bundle": "turbo run build --filter=good-a11y && pnpm --filter good-a11y run bundle"
  },
  "dependencies": {
    "puppeteer-core": "25.13.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@effect/tsgo": "0.45.0",
    "@foldkit/oxlint-plugin": "0.15.2",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "24.13.6",
    "effect": "4.0.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "varlock": "1.20.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
