# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Local calibrator only (`alchemy dev`): a one-off daily token cap in place of
# CALIBRATION_JUDGE_TOKENS in apps/scanner/src/judge-limits.ts. Unset everywhere else.
# @type=number
# @sensitive=false
CALIBRATION_JUDGE_TOKENS=

# Scanner Worker, read at deploy: true turns on the empty form submits of the
# rendered check (docs/rendered-probes.md). Unset or false everywhere else.
# @type=boolean
# @sensitive=false
EMPTY_SUBMITS=
