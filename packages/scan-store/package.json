{
  "name": "@eaa-check/scan-store",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src",
    "migrations",
    "test/local-d1.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./src/d1.ts",
      "import": "./dist/d1.js",
      "default": "./dist/d1.js"
    },
    "./testing": {
      "types": "./test/local-d1.ts",
      "default": "./test/local-d1.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@eaa-check/core": "workspace:*",
    "alchemy": "2.0.0-beta.81",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-d1": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "@types/sql.js": "1.4.11",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "sql.js": "1.14.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
