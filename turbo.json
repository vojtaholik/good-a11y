{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    },
    "@good-a11y/core#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/research/facts/**"
      ]
    },
    "@good-a11y/facts#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/research/facts/**"]
    },
    "@good-a11y/scanner#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/scan-store/migrations/**"
      ]
    },
    "@good-a11y/guides#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/guides/**",
        "$TURBO_ROOT$/docs/evals.md",
        "$TURBO_ROOT$/evals/results.json"
      ]
    },
    "@good-a11y/evals#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/guides/**"]
    },
    "@good-a11y/web#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/good-a11y/**",
        "$TURBO_ROOT$/evals/results.json"
      ]
    },
    "@good-a11y/web#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/good-a11y/**",
        "$TURBO_ROOT$/apps/good-a11y/bundle/**",
        "$TURBO_ROOT$/evals/results.json"
      ]
    }
  }
}
