{
  "name": "@good-a11y/guides",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./check-guides": {
      "types": "./src/check-guides.ts",
      "import": "./dist/check-guides.js",
      "default": "./dist/check-guides.js"
    },
    "./data": {
      "types": "./src/guides.generated.ts",
      "import": "./dist/guides.generated.js",
      "default": "./dist/guides.generated.js"
    },
    "./flow-for-check": {
      "types": "./src/flow-for-check.ts",
      "import": "./dist/flow-for-check.js",
      "default": "./dist/flow-for-check.js"
    },
    "./guide": {
      "types": "./src/guide.ts",
      "import": "./dist/guide.js",
      "default": "./dist/guide.js"
    },
    "./search": {
      "types": "./src/search.ts",
      "import": "./dist/search.js",
      "default": "./dist/search.js"
    },
    "./skill-index": {
      "types": "./src/skill-index.ts",
      "import": "./dist/skill-index.js",
      "default": "./dist/skill-index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "guides": "pnpm run --silent build > /dev/null; node scripts/generate.ts && pnpm run --silent build",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@good-a11y/facts": "workspace:*",
    "effect": "4.0.0",
    "minisearch": "7.2.0",
    "stemmer": "2.0.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
